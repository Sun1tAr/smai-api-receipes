{
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Машинно-читаемый код ошибки.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Дополнительные сведения; может быть пустым. Для `VALIDATION_ERROR` — `{\"fields\": [{\"loc\": [\"body\", \"name\"], \"type\": \"missing\"}]}`: `loc` — список строк с местом ошибки, `type` — тип ошибки Pydantic; значения и тексты исключений не возвращаются.",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Описание ошибки на английском, безопасное для показа.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "example": {
          "error": {
            "code": "INTERNAL_ERROR",
            "details": {},
            "message": "Internal server error"
          }
        },
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GenerateMenuRequest": {
        "additionalProperties": false,
        "example": {
          "peopleCount": 4,
          "weeklyBudget": 5000
        },
        "properties": {
          "peopleCount": {
            "description": "Количество человек, от 1 до 20.",
            "examples": [
              4
            ],
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Peoplecount",
            "type": "integer"
          },
          "weeklyBudget": {
            "description": "Недельный бюджет в рублях, не более двух знаков после запятой.",
            "examples": [
              5000,
              1500.5
            ],
            "exclusiveMinimum": 0.0,
            "maximum": 1000000.0,
            "title": "Weeklybudget",
            "type": "number"
          }
        },
        "required": [
          "peopleCount",
          "weeklyBudget"
        ],
        "title": "GenerateMenuRequest",
        "type": "object"
      },
      "HealthResponse": {
        "example": {
          "status": "ok"
        },
        "properties": {
          "status": {
            "const": "ok",
            "description": "Всегда `ok`, если сервис готов.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IngredientResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "number"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "name",
          "quantity",
          "unit"
        ],
        "title": "IngredientResponse",
        "type": "object"
      },
      "MenuResponse": {
        "properties": {
          "recipes": {
            "items": {
              "$ref": "#/components/schemas/RecipeResponse"
            },
            "title": "Recipes",
            "type": "array"
          }
        },
        "required": [
          "recipes"
        ],
        "title": "MenuResponse",
        "type": "object"
      },
      "NutritionResponse": {
        "properties": {
          "calories": {
            "title": "Calories",
            "type": "number"
          },
          "carbohydrates": {
            "title": "Carbohydrates",
            "type": "number"
          },
          "fats": {
            "title": "Fats",
            "type": "number"
          },
          "proteins": {
            "title": "Proteins",
            "type": "number"
          }
        },
        "required": [
          "calories",
          "proteins",
          "fats",
          "carbohydrates"
        ],
        "title": "NutritionResponse",
        "type": "object"
      },
      "RecipeResponse": {
        "properties": {
          "calories": {
            "description": "Калорийность, ккал.",
            "title": "Calories",
            "type": "number"
          },
          "cookingTime": {
            "description": "Время готовки, мин.",
            "title": "Cookingtime",
            "type": "number"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientResponse"
            },
            "title": "Ingredients",
            "type": "array"
          },
          "instructions": {
            "items": {
              "type": "string"
            },
            "title": "Instructions",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "nutrition": {
            "$ref": "#/components/schemas/NutritionResponse"
          },
          "photo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ссылка на фотографию; пока всегда null.",
            "title": "Photo"
          }
        },
        "required": [
          "name",
          "ingredients",
          "calories",
          "nutrition",
          "cookingTime",
          "instructions"
        ],
        "title": "RecipeResponse",
        "type": "object"
      },
      "TaskCreatedResponse": {
        "example": {
          "task_id": "b1e2c3d4-5678-90ab-cdef-1234567890ab"
        },
        "properties": {
          "task_id": {
            "description": "Идентификатор задачи (UUID) для запроса статуса.",
            "examples": [
              "b1e2c3d4-5678-90ab-cdef-1234567890ab"
            ],
            "title": "Task Id",
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "TaskCreatedResponse",
        "type": "object"
      },
      "TaskStatus": {
        "enum": [
          "pending",
          "in_progress",
          "done",
          "failed"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "TaskStatusResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Описание ошибки; null, если status не failed.",
            "title": "Error"
          },
          "menu": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MenuResponse"
              },
              {
                "type": "null"
              }
            ],
            "description": "Результат генерации; null, если status не done."
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        },
        "required": [
          "status",
          "menu",
          "error"
        ],
        "title": "TaskStatusResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Сервис рецептов SmartMeal (MS-4): ядро домена рецептов и генерация меню через Ollama.\n\nВсе ошибки возвращаются в едином формате `{\"error\": {\"code\": \"...\", \"message\": \"...\", \"details\": {}}}`.",
    "title": "SmartMeal recipes service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/generate-menu": {
      "post": {
        "description": "Создаёт задачу генерации недельного меню и сразу возвращает её идентификатор. Результат запрашивается через `GET /generate-menu/{task_id}`.",
        "operationId": "generate_menu_generate_menu_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateMenuRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "example": {
                  "task_id": "b1e2c3d4-5678-90ab-cdef-1234567890ab"
                },
                "schema": {
                  "$ref": "#/components/schemas/TaskCreatedResponse"
                }
              }
            },
            "description": "Задача создана."
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "details": {
                      "fields": [
                        {
                          "loc": [
                            "body",
                            "peopleCount"
                          ],
                          "type": "int_type"
                        }
                      ]
                    },
                    "message": "Request validation failed"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Некорректные параметры запроса."
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "details": {},
                    "message": "Internal server error"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Внутренняя ошибка сервиса."
          }
        },
        "summary": "Запуск генерации меню (API-1)",
        "tags": [
          "generate-menu"
        ]
      }
    },
    "/generate-menu/{task_id}": {
      "get": {
        "description": "Возвращает статус задачи. `menu` заполнено только при `done`, `error` — только при `failed`. Неизвестный и некорректный идентификатор дают 404.",
        "operationId": "get_generation_result_generate_menu__task_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "done": {
                    "summary": "Задача завершена",
                    "value": {
                      "error": null,
                      "menu": {
                        "recipes": [
                          {
                            "calories": 320,
                            "cookingTime": 15,
                            "ingredients": [
                              {
                                "name": "Овсяные хлопья",
                                "quantity": 200,
                                "unit": "г"
                              },
                              {
                                "name": "Молоко",
                                "quantity": 500,
                                "unit": "мл"
                              }
                            ],
                            "instructions": [
                              "Вскипятить молоко.",
                              "Добавить хлопья и варить."
                            ],
                            "name": "Овсяная каша с ягодами",
                            "nutrition": {
                              "calories": 320,
                              "carbohydrates": 50,
                              "fats": 8,
                              "proteins": 12
                            },
                            "photo": null
                          }
                        ]
                      },
                      "status": "done"
                    }
                  },
                  "failed": {
                    "summary": "Задача завершилась ошибкой",
                    "value": {
                      "error": "Queue timeout",
                      "menu": null,
                      "status": "failed"
                    }
                  },
                  "in_progress": {
                    "summary": "Задача выполняется",
                    "value": {
                      "error": null,
                      "menu": null,
                      "status": "in_progress"
                    }
                  },
                  "pending": {
                    "summary": "Задача в очереди",
                    "value": {
                      "error": null,
                      "menu": null,
                      "status": "pending"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/TaskStatusResponse"
                }
              }
            },
            "description": "Статус задачи."
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "details": {},
                    "message": "Generation task not found"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Задача не найдена."
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "details": {},
                    "message": "Internal server error"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Внутренняя ошибка сервиса."
          }
        },
        "summary": "Получение результата генерации (API-2)",
        "tags": [
          "generate-menu"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Выполняет `SELECT 1` к PostgreSQL. Возвращает 200, если БД отвечает, и 503 в едином формате ошибок, если нет. Доступность Ollama не проверяется.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "details": {},
                    "message": "Service is unavailable"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "База данных недоступна."
          }
        },
        "summary": "Проверка готовности сервиса",
        "tags": [
          "service"
        ]
      }
    }
  }
}
