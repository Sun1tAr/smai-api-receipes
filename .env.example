# Скопируйте в .env и заполните. Обязательные значения помечены.
# --- PostgreSQL ---
# Обязательно: DB_HOST (в Compose всегда postgres; значения ниже — локальные заглушки), DB_NAME, DB_USER, DB_PASSWORD.
DB_HOST=postgres
DB_PORT=
DB_NAME=receipes
DB_USER=receipes
DB_PASSWORD=change-me-local-only
DB_TIMEOUT_SECONDS=
# --- Сервис ---
LOG_LEVEL=
# Необязательно: ожидание чужой блокировки при миграциях, секунд (по умолчанию 30).
MIGRATION_LOCK_TIMEOUT_SECONDS=
# Хостовой порт Compose (контейнер всегда слушает 8000); по умолчанию 8001.
RECEIPES_HTTP_PORT=
# Необязательно: базовый URL OTLP HTTP collector, без /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# --- Ollama ---
# Обязательно: адрес Ollama, например http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# По умолчанию qwen2.5:7b (тег должен быть загружен в Ollama).
OLLAMA_MODEL=
OLLAMA_CONNECT_TIMEOUT_SECONDS=
OLLAMA_TIMEOUT_SECONDS=
# По умолчанию 8192; должно быть не меньше OLLAMA_NUM_PREDICT + 1536.
OLLAMA_NUM_CTX=
OLLAMA_NUM_PREDICT=
OLLAMA_TEMPERATURE=
OLLAMA_KEEP_ALIVE=
# --- MS-2 (справочники) ---
# Обязательно: адрес MS-2 «Словарь» (GET /dictionaries), например http://dictionary:8000.
MS2_BASE_URL=http://dictionary:8000
# По умолчанию 5 секунд: лимит и на каждую фазу запроса, и на запрос целиком.
MS2_TIMEOUT_SECONDS=
# --- MCP ВкусВилла (корзина API-14) ---
# Необязательно: полный HTTP(S) URL MCP. Без него API-14 отвечает 503 для готовых негостевых рецептов.
VKUSVILL_MCP_URL=
MCP_CALL_TIMEOUT_SECONDS=5
MCP_CALL_RETRIES=1
MCP_CONCURRENCY=4
MCP_CACHE_TTL_SECONDS=900
CART_DEADLINE_SECONDS=35
# --- Генерация меню ---
GENERATION_WORKER_ENABLED=
GENERATION_WORKER_INTERVAL_SECONDS=
GENERATION_BAD_RESPONSE_RETRIES=
GENERATION_METRICS_REFRESH_SECONDS=15
REPLACE_WAIT_SECONDS=120
# Последние лайки в промпте (0–10). 0 отключает выборку.
LIKES_IN_PROMPT_LIMIT=10
